{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nabtiq.example/schemas/design-tokens-alpha.schema.json",
  "title": "Corporate/Brochure Alpha Design Tokens",
  "type": "object",
  "required": [
    "id",
    "type",
    "schema_version",
    "project",
    "content_hash",
    "tokens",
    "semantic",
    "contrast_pairs"
  ],
  "properties": {
    "type": {
      "const": "design-tokens"
    },
    "tokens": {
      "type": "object",
      "required": [
        "color",
        "typography",
        "layout",
        "radius",
        "glass",
        "motion"
      ]
    },
    "semantic": {
      "type": "object",
      "required": [
        "light",
        "dark"
      ]
    }
  }
}
